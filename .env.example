# --- MongoDB ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=chat_db

# --- OTP ---
# Bắt buộc. Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -hex 32
OTP_SECRET=

# console: in OTP ra log (phát triển) | smtp: gửi email thật | brevo: gửi qua HTTP API (dùng khi host chặn cổng SMTP)
MAIL_MODE=console

# --- SMTP (chỉ cần khi MAIL_MODE=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Brevo (chỉ cần khi MAIL_MODE=brevo) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=
